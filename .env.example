# Copia este archivo a .env en la raíz. No publiques tus credenciales.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB local o URI de tu instancia de MongoDB Atlas.
MONGO_URI=mongodb://127.0.0.1:27017/polimatch?replicaSet=rs0
# Genera un valor con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# 0 sin proxy. Configura solo el número real de proxies de confianza del despliegue.
TRUST_PROXY=0

# Necesarias para subir fotos de perfil.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
